https://contents.islab.di.unimi.it/datasets/orders.json.zip */
/* retrieve the orders submitted on Tuesday (order_dow = 2) at 8 */
db.orders.find(
{
    "order_dow": 2,
    "order_hour_of_day": 8
},
{
    "order_id": 1,
    "order_dow": 1,
    "order_hour_of_day": 1
})

/* retrieve the orders submitted on Tuesday (order_dow = 2) between 8 and 20 */
db.orders.find(
{
    "order_dow": 2,
    "order_hour_of_day": {
        "$gte": 8,
        "$lte": 20
    }
},
{
    "order_id": 1,
    "order_dow": 1,
    "order_hour_of_day": 1
})

/* not correct: only the second condition on order_hour_of_day is considered */
db.orders.find(
{
