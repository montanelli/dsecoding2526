/* retrieve the orders submitted on Tuesday (order_dow = 2) between 8 and 20 where "soda" is ordered as first product in the cart (add_to_cart_order) */
db.orders.find(
{
    "order_dow": 2,
    "order_hour_of_day": {
        "$gte": 8,
        "$lte": 20
    },
    "products": {
        "$elemMatch": {
            "product_name": {
                "$regex": /soda/i
            },
            "add_to_cart_order": 1
        }
    }
},
{
    "_id": 0,
    "order_id": 1,
    "order_dow": 1,
    "order_hour_of_day": 1,
    "products.product_name.$": 1,
    "products.add_to_cart_order": 1
});

