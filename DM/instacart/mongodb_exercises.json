/* retrieve the orders submitted on Tuesday (order_dow = 2) between 8 and 20 where "soda" is ordered. sort the result by user_id */
db.orders.find(
{
    "order_dow": 2,
    "$and": [
        {
            "order_hour_of_day": {
                "$gte": 8
            }
        },
        {
            "order_hour_of_day": {
                "$lte": 20
            }
        },
        {
            "products.product_name": /.*soda.*/i
        }
    ]
},
{
    "order_id": 1,
    "order_dow": 1,
    "order_hour_of_day": 1,
    "products.product_name.$": 1
})

/* retrieve the number of orders submitted on Tuesday (order_dow = 2) between 8 and 20 where "soda" is ordered. Sort the result by user_id */
db.orders.find(
{
    "order_dow": 2,
    "$and": [
        {
            "order_hour_of_day": {
                "$gte": 8
            }
        },
        {
            "order_hour_of_day": {
                "$lte": 20
            }
        },
        {
            "products.product_name": /.*soda.*/i
        }
    ]
},
{
    "user_id": 1,
    "order_id": 1,
    "order_dow": 1,
    "order_hour_of_day": 1,
    "products.product_name.$": 1
}).sort({
    "user_id": 1
})

/* alternative solution with aggregate */
db.orders.aggregate(
[
    {
        "$match": {
            "order_dow": 2,
            "$and": [
                {
                    "order_hour_of_day": {
                        "$gte": 8
                    }
                },
                {
                    "order_hour_of_day": {
                        "$lte": 20
                    }
                },
                {
                    "products.product_name": /.*soda.*/i
                }
            ]
        }
    },
    {
        "$project": {
            "user_id": 1,
            "order_id": 1,
            "order_dow": 1,
            "order_hour_of_day": 1
        }
    },
    {
        "$sort": {
            "user_id": 1
        }
    }
])

