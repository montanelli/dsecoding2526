    "order_hour_of_day": {
        "$gte": 8
    },
    "order_hour_of_day": {
        "$lte": 20
    }
},
{
    "order_id": 1,
    "order_dow": 1,
    "order_hour_of_day": 1
})

/* alternative solution with $and */

